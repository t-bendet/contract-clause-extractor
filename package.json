{
  "name": "clause-extractor",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "concurrently -n api,web -c blue,magenta --kill-others \"pnpm start:api\" \"pnpm start:web\"",
    "start:api": ".venv/bin/uvicorn app.main:app --reload --port 8000",
    "start:web": "pnpm --dir frontend dev",
    "gen:types": ".venv/bin/python scripts/export_openapi.py && pnpm --dir frontend exec openapi-typescript ../openapi.json -o src/generated/api.d.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
